; Stand-in for the retail game (NOT the real just volleyball). Used only to
; integration-test jv-mods loading + gate behaviour under a real Godot runtime.
config_version=5

[application]
config/name="fakegame"
run/main_scene="res://main.tscn"

[autoload]
InputBinds="*res://fake_input_binds.gd"
Lobby="*res://lobby.gd"
GameConfig="*res://fake_game_config.gd"
Net="*res://fake_net.gd"
