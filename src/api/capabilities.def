JV_CAP("player.consts_check", "1.3", READ, LOCAL, IMPL, "Altered-player-script checker for the player.consts bypass: flags writes to names still const, out of clamp / type, never-change names, non-host writes in synced lobbies, writes while unavailable, any mid-match write (values frozen for the match), client values differing from the host's start-of-match set, and folded copies in other scripts", "game/player/player.gd:1 Player", "consts_live, consts_status, consts_check_write, consts_audit, consts_findings, consts_clear_findings, consts_set_host_values")
