JV_CAP("player.tuning", "1.2", GAMEPLAY, LOCAL, IMPL, "PlayerFeel writes: movement, jump, sprint / stamina, dive, block, serve, animation and contact timing (the Goofy player library; host-synced in LAN / private / friends)", "game/player/player.gd:18 FEEL; game/player/player_feel.gd:9 move_speed", "(library IO: goofy)")
JV_CAP("player.consts", "1.2", GAMEPLAY, LOCAL, IMPL, "Player consts: the 34 gameplay values hard-coded in player.gd (made static vars at boot, match-wide). Edit in the lobby only; frozen for the whole match (mid-match writes return an error); the host sends its set to every player at match start. REQUIRES player.consts (same game build) on EVERY player: if anyone lacks it the whole match plays stock and the host is told who", "game/player/player.gd:25 COMBO_SPIKE_BONUS; game/player/player.gd:4821 SET_DUMP_SHORT; game/player/player.gd:5862 BLOCK_TURN", "player_consts_get, player_consts_set, player_consts_reset, player_consts_locked")
JV_CAP("goofy.player", "1.2", OFFLINE, LOCAL, IMPL, "Set / clear this mod's Goofy PLAYER layer (player library params incl. player.body_scale; owner mod:<name>:player). Live offline; kept and re-applied when offline again", "game/player/player.gd:18 FEEL; game/player/player.gd:1 Player", "goofy_player_set_override, goofy_player_clear_override")
JV_CAP("goofy.ball_live", "1.2", OFFLINE, LOCAL, IMPL, "Live writes on a ball in flight: velocity, curve, impulse (unsynced, so offline only)", "game/ball/ball.gd:74 vel; game/ball/ball.gd:81 curve", "goofy_ball_set_velocity, goofy_ball_set_curve, goofy_ball_impulse")
JV_CAP("goofy.events", "1.2", READ, LOCAL, IMPL, "Ball and player game events relayed by Goofy with ball / player index (bounced, struck, net_hit, ..., swung, jumped, launched, dove_into_net, ...)", "game/ball/ball.gd:13 bounced; game/player/player.gd:130 swung", "events goofy_ball_event, goofy_player_event")
JV_CAP("goofy.host_sync", "1.2", SYNC, HOST, IMPL, "Host-authoritative Goofy gameplay: the host publishes its gameplay ball + player params and time scale to modded peers (JVGF packets v2, clamped on receive); clients apply them from match start to match end, visual-only params stay local", "-", "(library: goofy; status via goofy_sync_status)")

JV_CAP("gameplay.settings", "1.3", GAMEPLAY, HOST, IMPL, "Gameplay settings registry and read hook: mods register settings that change play (id mod.setting, type, default, range, label, tooltip, category; sync class gameplay only, visual-only refused) at config setup; every read goes through gameplay_get (stock while gameplay is closed, the host's value for clients in LAN / private / friends lobbies, else the local value; always clamped); values saved per mod with versioned migration; controls auto-built in the game's Settings panel (mods tab)", "game/ui/settings_panel.gd:1 SettingsPanel; game/ui/settings_panel.gd:122 _tabs; game/ui/settings_panel.gd:1073 _tab; game/ui/settings_panel.gd:921 _subheader; game/ui/settings_panel.gd:1190 _check; game/ui/settings_panel.gd:1228 _select; game/ui/settings_panel.gd:1252 _range", "gameplay_register, gameplay_register_setting, gameplay_unregister, gameplay_get, gameplay_get_all, gameplay_set, gameplay_reset, gameplay_list, gameplay_info, gameplay_role")
JV_CAP("gameplay.settings_sync", "1.3", SYNC, HOST, IMPL, "Host broadcast hooks for the gameplay settings registry: the host exports its effective values (dictionary / JVGS bytes / hash), clients apply the host's payload (validated, unknown ids ignored, clamped); match-wide missing-mod rule: players' gameplay mod lists, decided at match start (a mod any player lacks is off for everyone, host included; texture mods never), settings locked for the match, loader warning; the transport belongs to the host-sync library", "-", "gameplay_manifest_bytes, gameplay_set_peer_manifest, gameplay_remove_peer, gameplay_match_start, gameplay_match_end, gameplay_set_host_manifest, gameplay_snapshot, gameplay_snapshot_bytes, gameplay_apply_snapshot, gameplay_clear_host")
JV_CAP("game.rules", "1.3", GAMEPLAY, HOST, IMPL, "Game rules on the host's rally judge (clients never judge): team touches (four-touches fault, point to the other team), one player's consecutive touches (CONSECUTIVE bar), block / body block reset, PlayerFeel.block_classic; stock restored on revert", "game/core/rules.gd:13 TOUCHES_PER_SIDE; game/core/rules.gd:63 last_toucher; game/core/rally.gd:155 touch_count; game/core/rally.gd:157 last_toucher; game/core/rally.gd:590 pre_tick; game/core/rally.gd:898 judge_touch; game/core/rally.gd:1113 touch_count; game/player/player_feel.gd:572 block_classic", "game_rules_info, game_rules_state")
JV_CAP("shots.query", "1.1", READ, LOCAL, IMPL, "Extra shots / curve: shot ids, armed shot, last spin / topspin / curve / float / event, spin bar, range box, counters, status", "game/ball/ball.gd:81 curve; game/ball/ball.gd:1558 start_float", "shots_list, shots_armed, shots_last, shots_spin_bar, shots_range_box, shots_counts, shots_status")
